{
  "uid": "complaint-routing",
  "title": "Complaint Routing \u2014 Application and VM",
  "schemaVersion": 39,
  "version": 3,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "DA3408",
    "complaint-routing"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application health \u2014 1 means healthy",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "complaint-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"service_probes\"}",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Complaints processed since backend restart",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "complaint-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(complaint_predictions_total{job=\"backend\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Prediction requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "complaint-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(complaint_http_requests_total{job=\"backend\",route=~\"/predict.*\"}[1m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Prediction p95 response preparation time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "complaint-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(complaint_http_duration_seconds_bucket{job=\"backend\",route=~\"/predict.*\"}[1m])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Routing decisions per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "complaint-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (rate(complaint_predictions_total{job=\"backend\"}[1m]))",
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Mean prediction confidence \u2014 last five minutes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "complaint-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(complaint_prediction_confidence_sum{job=\"backend\"}[5m])) / sum(increase(complaint_prediction_confidence_count{job=\"backend\"}[5m]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
